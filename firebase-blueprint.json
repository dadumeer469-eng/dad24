{
  "entities": {
    "Dish": {
      "title": "Dish",
      "description": "Represents a menu food item or a home service in dadu24#7.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "type": { "type": "string" }
      },
      "required": ["id", "name", "price", "category", "isAvailable", "type"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Standard buyer profiles and admin credentials mapped in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string" },
        "ordersCount": { "type": "number" }
      },
      "required": ["uid", "name", "phone", "address", "role", "ordersCount"]
    },
    "Order": {
      "title": "Order",
      "description": "Client placement records for both food deliveries and home services.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "userAddress": { "type": "string" },
        "items": { "type": "array" },
        "totalPrice": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" },
        "riderName": { "type": "string" },
        "eta": { "type": "string" },
        "createdAt": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "orderType": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "userPhone", "userAddress", "items", "totalPrice", "deliveryFee", "grandTotal", "status", "paymentMethod", "orderType"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Dynamic layout configuration toggles like deliveryFee rates.",
      "type": "object",
      "properties": {
        "deliveryFee": { "type": "number" }
      },
      "required": ["deliveryFee"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Real-time chime push notification logs mapped to specific user ID directories.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "object" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "message", "createdAt", "read"]
    },
    "GroceryCategory": {
      "title": "GroceryCategory",
      "description": "A collection specifying grocery divisions (e.g. Dairy, Fruits & Vegetables).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "position": { "type": "number" }
      },
      "required": ["id", "name", "isAvailable"]
    },
    "GroceryProduct": {
      "title": "GroceryProduct",
      "description": "Individual grocery catalog items stocked inside the warehouses for standalone checkout.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "unit": { "type": "string" },
        "stock": { "type": "number" },
        "categoryId": { "type": "string" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["id", "name", "imageUrl", "price", "unit", "stock", "categoryId", "isAvailable"]
    },
    "GroceryOrder": {
      "title": "GroceryOrder",
      "description": "Orders made dynamically within the standalone Grocery Cart.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "userAddress": { "type": "string" },
        "items": { "type": "array" },
        "totalPrice": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "orderType": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "userPhone", "userAddress", "items", "totalPrice", "deliveryFee", "grandTotal", "status", "paymentMethod", "orderType"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A real-time chat message sent between a customer and a rider for an active order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["user", "rider"] },
        "text": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["id", "senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "PayoutRequest": {
      "title": "PayoutRequest",
      "description": "Withdrawal and payout disbursement requests initiated by riders.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "riderId": { "type": "string" },
        "riderName": { "type": "string" },
        "riderPhone": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["id", "riderId", "riderName", "amount", "paymentMethod", "status"]
    }
  },
  "firestore": {
    "menu/{dishId}": {
      "schema": "Dish",
      "description": "The shared list of food and service items."
    },
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Authentication users metadata registry."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection storing live active and finished client delivery bookings."
    },
    "orders/{orderId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages between the rider and the customer for a specific order."
    },
    "settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Host-accessible parameter overrides such as custom delivery rate values."
    },
    "notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Alert elements targeting specific profile identifiers."
    },
    "groceryCategories/{categoryId}": {
      "schema": "GroceryCategory",
      "description": "Standalone retail divisions for grocery items."
    },
    "groceryProducts/{productId}": {
      "schema": "GroceryProduct",
      "description": "Specific grocery catalog products for user order placement."
    },
    "groceryOrders/{orderId}": {
      "schema": "GroceryOrder",
      "description": "Standalone history log of user grocery checkouts."
    },
    "payoutRequests/{payoutId}": {
      "schema": "PayoutRequest",
      "description": "Rider payout and withdrawal ledger requests."
    }
  }
}
