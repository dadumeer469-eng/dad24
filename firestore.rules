rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checking profile document status
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user has the 'admin' role
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.uid == 'vL9LpYI3q5e6bFIsAdmInTrUgGer12' ||
         request.auth.token.email == '03277004471@dadu247.com' ||
         request.auth.token.email == 'dadumeer469@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Check if the authenticated user has the 'rider' role
    function isRider() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rider');
    }

    // Users Collection rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Menu Collection rules
    match /menu/{dishId} {
      allow read: if true; // Publicly readable for browsing
      allow write, delete: if isAdmin(); // Strictly restricted to admin
    }

    // Orders Collection rules
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      
      // Separate allowed reads to guarantee static query safety for Firestore analyzer
      allow read: if isAdmin();
      allow read: if isRider() && resource.data.status == "pending";
      allow read: if isRider() && resource.data.riderId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Separate/clean updates for simplicity
      allow update: if isAdmin();
      allow update: if isRider() && (
        // Case A: Rider accepting a pending order
        (resource.data.status == "pending" && request.resource.data.riderId == request.auth.uid && request.resource.data.status == "accepted") ||
        // Case B: Rider updating metadata of their accepted order (e.g. marking complete/delivered)
        (resource.data.riderId == request.auth.uid)
      );
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status;
      
      allow delete: if isAdmin();
    }

    // Settings Collection rules
    match /settings/{settingId} {
      allow read: if true; // Any customer can retrieve the current delivery cost coefficient
      allow write: if isAdmin();
    }

    // Notifications Collection rules
    match /notifications/{notificationId} {
      allow create: if isAdmin() || isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
